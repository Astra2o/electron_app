{
  "name": "circle-to-lens",
  "version": "0.1.0",
  "private": true,
  "description": "System-wide Circle-to-Lens for Windows. Press a global hotkey, draw a circle anywhere on your screen with a white pencil + RGB-rainbow glow, and Google Lens searches the cropped region instantly.",
  "author": "Circle to Lens",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "dev": "env -u ELECTRON_RUN_AS_NODE electron . --inspect=9229",
    "icon": "env -u ELECTRON_RUN_AS_NODE electron scripts/build-icon.js",
    "prebuild": "npm run icon",
    "build": "electron-builder --win",
    "build:portable": "npm run icon && electron-builder --win portable",
    "build:installer": "npm run icon && electron-builder --win nsis",
    "build:mac": "npm run icon && electron-builder --mac dmg",
    "build:dmg": "npm run build:mac"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.circletools.lens",
    "productName": "Circle to Lens",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lens.js",
      "settings-store.js",
      "start-menu-shortcut.js",
      "mac-shortcuts.js",
      "icon-renderer.js",
      "overlay/**/*",
      "settings/**/*",
      "home/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "target": [
        { "target": "dmg", "arch": ["arm64"] }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Circle to Lens does not use the microphone.",
        "NSCameraUsageDescription": "Circle to Lens does not use the camera."
      }
    },
    "dmg": {
      "title": "Circle to Lens",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "extraResources": [
      {
        "from": "docs/MAC_SHORTCUTS.txt",
        "to": "MAC_SHORTCUTS.txt"
      }
    ]
  }
}
